<?xml version="1.0" encoding="utf-8"?>
<!-- Icono para Android 7.x (API 24-25), que no admite adaptive-icon. En API 26+ manda mipmap-anydpi-v26. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="135" android:startColor="#6C5CFF" android:endColor="#00D1B2" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
